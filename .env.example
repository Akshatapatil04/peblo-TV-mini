# Peblo TV Mini — Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# ==========================================
# Application & Environment
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Peblo TV Mini API

# ==========================================
# Database Configuration (PostgreSQL / SQLite)
# ==========================================
# For Local SQLite (Default quickstart):
DATABASE_URL=sqlite+aiosqlite:///storage/peblo_tv.db

# For PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql+asyncpg://peblo:peblo_password@localhost:5432/peblo_tv
DATABASE_ECHO=false

# ==========================================
# Storage Backend Configuration
# ==========================================
# Options: 'local' | 'r2' | 's3'
STORAGE_BACKEND=local

# Local Storage settings:
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_URL_BASE=http://localhost:8000/storage

# Cloudflare R2 / AWS S3 settings (used when STORAGE_BACKEND=r2):
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=peblo-tv-media
# R2_PUBLIC_URL_BASE=https://media.peblo.tv

# ==========================================
# Authentication & Role-Based Access Control
# ==========================================
ADMIN_API_KEY=peblo-admin-secret-key
EDITOR_API_KEY=peblo-editor-secret-key

# ==========================================
# Secrets Management Guidance
# ==========================================
# In production, NEVER commit raw secret keys or database passwords to git.
# Recommended practices:
# 1. AWS Secrets Manager / GCP Secret Manager / Doppler for automated rotation.
# 2. GitHub Actions Secrets for CI/CD pipelines.
# 3. Cloudflare Workers / Pages environment secrets for frontend edge delivery.
